@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage a family profile

Container_Boundary(web, "Saturdaze web application") {
  Component(page, "ProfilePage", "Angular component", "Presents and edits the family profile")
  Component(client, "FamilyService", "Angular service", "Maps editable state to API contracts")
}
Container_Boundary(api, "Saturdaze API") {
  Component(controller, "FamilyController", "ASP.NET Core", "Exposes family read and write endpoints")
  Component(handler, "SaveFamilyProfileCommandHandler", "Application handler", "Validates and persists the aggregate")
  Component(entity, "Family aggregate", "Domain state", "Owns members, commitments, and preferences")
  ComponentDb(db, "AppDbContext", "EF Core", "Stores families, members, commitments, and preferences")
}
Rel(page, client, "Calls")
Rel(client, controller, "PUT /api/family", "JSON/HTTPS")
Rel(controller, handler, "Dispatches request")
Rel(handler, entity, "Replaces child collections")
Rel(handler, db, "Reads and replaces profile state", "EF Core")
@enduml
