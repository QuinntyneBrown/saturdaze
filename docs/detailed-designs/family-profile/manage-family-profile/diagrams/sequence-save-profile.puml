@startuml
title UML sequence behaviour — Manage a family profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Family organizer" as actor
box "Frontend — Saturdaze web application" #E0F2FE
  participant "ProfilePage" as page
  participant "FamilyService" as client
end box
box "Backend — Saturdaze API application" #D1FADF
  participant "FamilyController" as controller
end box
box "Backend — Saturdaze Application and Domain" #ECFDF3
  participant "SaveFamilyProfileCommandHandler" as handler
  participant "Family aggregate" as entity
end box
box "Backend — Saturdaze Infrastructure" #FFF4E5
  database "Saturdaze database" as db
end box
actor -> page : Edit profile and save
page -> client : saveProfile(EditableFamilyProfile)
client -> controller : PUT /api/family
controller -> controller : Authenticate and validate request
controller -> handler : Send SaveFamilyProfileCommand
handler -> db : Load authorized family aggregate
db --> handler : Current state
alt profile input is valid
  handler -> entity : Apply L2-010 collection changes
  entity --> handler : Updated state
  handler -> db : Save changes
  db --> handler : Commit result
  handler --> controller : Typed result
  controller --> client : Successful HTTP response
  client --> page : Present feature result
  page --> actor : See persisted family profile
else input is invalid
  handler --> controller : Controlled error
  controller --> client : ProblemDetails response
  client --> page : Present safe error state
  page --> actor : See field validation errors
end
@enduml
