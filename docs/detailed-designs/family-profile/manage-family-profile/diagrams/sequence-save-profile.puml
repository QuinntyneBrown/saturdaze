@startuml
title UML sequence behaviour - Manage a family profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "User" as actor
box "Frontend - Saturdaze Angular application" #E0F2FE
 participant "FamilyPage" as page
 participant "FamilyService" as client
end box
box "Backend - Saturdaze API" #D1FADF
 participant "FamilyController" as controller
end box
box "Backend - Saturdaze Application and Domain" #ECFDF3
 participant "GetFamilyProfileQueryHandler\nSaveFamilyProfileCommandHandler" as handler
end box
box "Backend - Saturdaze Infrastructure" #FFF4E5
 database "AppDbContext\nSQL Server" as db
end box
actor -> page : Open /family
page -> client : load()
client -> controller : GET /api/family
controller -> handler : GetFamilyProfileQuery
handler -> db : L2-009 read owned family with members, commitments, preferences
db --> handler : Aggregate
handler --> controller : FamilyProfileDto
controller --> client : 200 profile
client --> page : getFamily() and getEditableProfile() signals
actor -> page : Edit member, commitment, home, likes, or preference in a dialog
page -> client : saveProfile(complete editable profile)
client -> controller : PUT /api/family
controller -> handler : SaveFamilyProfileCommand after authentication
handler -> handler : ValidationBehavior runs SaveFamilyProfileCommandValidator
alt Validation fails
 handler --> controller : ValidationException
 controller --> client : 400 validation errors; profile unchanged
 client --> page : Error message
else Valid profile
 handler -> db : Resolve owned family or attach first-time family
 db --> handler : Current aggregate
 handler -> handler : L2-010 synchronize collections; retain matched IDs
 handler -> db : Save additions, edits, and removals
 db --> handler : Saved
 handler -> db : Reread full profile
 db --> handler : Persisted aggregate
 handler --> controller : FamilyProfileDto
 controller --> client : 200 profile
 client --> page : Editable and presentation state
end
@enduml
