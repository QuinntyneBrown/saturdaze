@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Materialize recurring commitments

Person(actor, "Family organizer", "Plans a weekend around fixed commitments")
System_Boundary(saturdaze, "Saturdaze") {
  Container(web, "Saturdaze web application", "Angular", "Requests a weekend plan")
  Container(api, "Saturdaze API", "ASP.NET Core", "Builds weekend plans")
  ContainerDb(db, "Saturdaze database", "SQL Server", "Stores commitments and itinerary blocks")
}
Rel(actor, web, "Uses", "HTTPS")
Rel(web, api, "Requests current weekend", "JSON/HTTPS")
Rel(api, db, "Reads commitments and writes blocks", "EF Core")
@enduml
