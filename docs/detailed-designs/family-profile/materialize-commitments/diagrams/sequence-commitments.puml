@startuml
title UML sequence behaviour — Materialize recurring commitments
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Family organizer" as actor
box "Frontend — Saturdaze web application" #E0F2FE
  participant "HomePage" as page
  participant "WeekendPlanService" as client
end box
box "Backend — Saturdaze API application" #D1FADF
  participant "WeekendsController" as controller
end box
box "Backend — Saturdaze Application and Domain" #ECFDF3
  participant "GenerateWeekendCommandHandler" as handler
  participant "WeekendPlanner" as entity
end box
box "Backend — Saturdaze Infrastructure" #FFF4E5
  database "Saturdaze database" as db
end box
actor -> page : Plan the upcoming weekend
page -> client : plan(weekendOf)
client -> controller : POST /api/weekends/plan
controller -> controller : Authenticate and validate request
controller -> handler : Send GenerateWeekendCommand
handler -> db : Load family commitments
db --> handler : Current state
alt commitments do not overlap
  handler -> entity : Apply L2-011 fixed locked blocks
  entity --> handler : Updated state
  handler -> db : Save changes
  db --> handler : Commit result
  handler --> controller : Typed result
  controller --> client : Successful HTTP response
  client --> page : Present feature result
  page --> actor : See commitments reserved in itinerary
else commitments overlap
  handler --> controller : Controlled error
  controller --> client : ProblemDetails response
  client --> page : Present safe error state
  page --> actor : See controlled conflict error
end
@enduml
