@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Materialize recurring commitments

Container_Boundary(web, "Saturdaze web application") {
  Component(page, "HomePage", "Angular component", "Starts weekend planning")
  Component(client, "WeekendPlanService", "Angular service", "Calls weekend endpoints")
}
Container_Boundary(api, "Saturdaze API") {
  Component(controller, "WeekendsController", "ASP.NET Core", "Exposes planning endpoints")
  Component(handler, "GenerateWeekendCommandHandler", "Application handler", "Builds planner inputs")
  Component(entity, "WeekendPlanner", "Domain state", "Materializes commitments as blocks")
  ComponentDb(db, "AppDbContext", "EF Core", "Stores commitments and itinerary blocks")
}
Rel(page, client, "Calls")
Rel(client, controller, "POST /api/weekends/plan", "JSON/HTTPS")
Rel(controller, handler, "Dispatches request")
Rel(handler, entity, "Calls with commitments")
Rel(handler, db, "Reads commitments and writes blocks", "EF Core")
@enduml
