@startuml
title UML sequence behaviour - Manage the database with the CLI
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "System operator" as operator
box "Frontend - Saturdaze CLI application" #E0F2FE
  participant "RootCommandFactory" as root
  participant "System.CommandLine command" as command
end box
box "Backend - Saturdaze CLI handlers" #ECFDF3
  participant "MigrateCommandHandler" as migrate
  participant "SeedCommandHandler" as seed
  participant "ResetCommandHandler" as reset
  participant "IngestCommandHandler\nIngestionRunner" as ingest
end box
box "Backend - EF Core infrastructure" #FFF4E5
  participant "IJsonSeeder implementations" as seeders
  database "Configured database" as db
end box
operator -> root : Run saturdaze subcommand
root -> command : Parse global and command options
alt migrate
  command -> migrate : ExecuteAsync
  migrate -> db : Apply L2-043 pending migrations
  db --> migrate : Schema current
else seed
  command -> seed : ExecuteAsync(seedDir)
  seed -> seed : Resolve --seed-dir, SATURDAZE_SEED_DIR, bundle, or user directory
  alt Directory missing or no seed files
    seed --> command : Exit code 2 or 3 without mutation
  else Seed files found
    seed -> seeders : SeedAsync for each JSON file
    seeders -> db : Apply L2-044 idempotent upserts
    seed -> db : SaveChangesAsync
    db --> seed : Seed result
  end
else ingest
  command -> ingest : L2-077 ExecuteAsync(type, dryRun)
  ingest --> command : Per-type results; exit 0, 1 on a failed pass, or 2 on an unknown type
else reset with --yes and permitted environment
  command -> reset : ExecuteAsync(seedDir)
  reset -> db : Apply L2-045 EnsureDeleted, then Migrate (EnsureCreated for InMemory)
  reset -> seed : Reseed
  seed --> reset : Seed result
else reset without --yes or disallowed Production
  command --> operator : Refuse without mutation (4 for no --yes; 5 for Production)
end
@enduml
