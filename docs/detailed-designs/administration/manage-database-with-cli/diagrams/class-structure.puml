@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Manage the database with the CLI

class RootCommandFactory {
  +Create(args: string[]): RootCommand
}
class MigrateCommandHandler {
  +ExecuteAsync(ct: CancellationToken): Task<int>
}
class SeedCommandHandler {
  +ExecuteAsync(overrideDir: string, ct: CancellationToken): Task<int>
}
class ResetCommandHandler {
  +ExecuteAsync(seedDir: string, ct: CancellationToken): Task<int>
}
interface IJsonSeeder {
  +string FileName
  +SeedAsync(db: AppDbContext, json: Stream, ct: CancellationToken): Task<int>
}
interface ISeedPathResolver {
  +string BundleDirectory
  +Resolve(overridePath: string): string
}
class SeedPathResolver
class ResetGuard {
  +{static} int BlockedExitCode
  +{static} IsProductionBlocked(environmentName: string, allowProduction: bool): bool
}
class ActivitySeeder
class RestaurantSeeder
class LocalEventSeeder
class FamilySeeder
class UserSeeder
class EventSubmissionSeeder
class AppDbContext
ISeedPathResolver <|.. SeedPathResolver
SeedCommandHandler --> ISeedPathResolver : resolves directory
IJsonSeeder <|.. ActivitySeeder
IJsonSeeder <|.. RestaurantSeeder
IJsonSeeder <|.. LocalEventSeeder
IJsonSeeder <|.. FamilySeeder
IJsonSeeder <|.. UserSeeder
IJsonSeeder <|.. EventSubmissionSeeder
RootCommandFactory ..> ResetGuard : reset command checks
RootCommandFactory --> MigrateCommandHandler : dispatches
RootCommandFactory --> SeedCommandHandler : dispatches
RootCommandFactory --> ResetCommandHandler : dispatches
SeedCommandHandler --> IJsonSeeder : runs
MigrateCommandHandler --> AppDbContext : migrates
IJsonSeeder --> AppDbContext : upserts
ResetCommandHandler --> AppDbContext : resets
ResetCommandHandler --> SeedCommandHandler : reseeds
class IngestCommandHandler {
  +ExecuteAsync(typeArg: string, dryRun: bool, ct: CancellationToken): Task<int>
}
class IngestionRunner {
  +RunAsync(types: IReadOnlyList<IngestionType>, dryRun: bool, ct: CancellationToken): Task<IReadOnlyList<IngestionRun>>
}
RootCommandFactory --> IngestCommandHandler : dispatches
IngestCommandHandler --> IngestionRunner : runs
@enduml
