@startuml
title UML sequence behaviour - Change status, delete and restore a revision
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Administrator" as actor
box "Frontend - Saturdaze Admin Angular application" #E0F2FE
 participant "EmailTemplatePage (A9)" as page
 participant "TemplateHistoryDialog (AD9)" as history
 participant "DeleteTemplateDialog (AD8)" as remove
end box
box "Frontend - api library" #DBEAFE
 participant "AdminEmailTemplatesService" as client
end box
box "Backend - Saturdaze API" #D1FADF
 participant "AdminEmailTemplatesController" as controller
end box
box "Backend - Saturdaze Application" #ECFDF3
 participant "Admin/EmailTemplates handlers" as handlers
 participant "EmailTemplateRevisionWriter" as revisions
end box
box "Backend - Saturdaze Infrastructure" #FFF4E5
 database "AppDbContext\nSQL Server" as db
end box
actor -> page : Activate / Archive / Restore as draft
page -> client : setStatus(id, status, version)
client -> controller : POST /api/admin/email-templates/{id}/status
controller -> handlers : ChangeEmailTemplateStatusCommand
handlers -> handlers : system template stays Active, else system_template (L2-129 AC2)
handlers -> revisions : Write(template, Status)
handlers -> db : SaveChangesAsync
controller --> page : 200, status chip and actions change (L2-129 AC5)
actor -> page : History
page -> history : open
history -> client : revisions(id)
client -> controller : GET /api/admin/email-templates/{id}/revisions
controller --> history : newest first (L2-130 AC1)
actor -> history : Load into editor on v1
history -> client : revision(id, 1)
client -> controller : GET .../revisions/1
controller --> history : full content (L2-130 AC2)
history --> page : content placed in the form, unsaved (L2-130 AC4)
actor -> page : Delete
page -> remove : open, names the template
actor -> remove : Delete template
remove --> page : confirm
page -> client : delete(id)
client -> controller : DELETE /api/admin/email-templates/{id}
controller -> handlers : DeleteEmailTemplateCommand (system_template refused)
handlers -> db : remove the template and its revisions
controller --> page : 204, navigate to A8 (L2-129 AC7)
@enduml
