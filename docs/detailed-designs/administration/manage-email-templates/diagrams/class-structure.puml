@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Manage email templates

enum EmailTemplateCategory {
  Account
  Notification
  Scheduled
  SpecialOccasion
  Marketing
}
enum EmailTemplateStatus {
  Draft
  Active
  Archived
}
enum EmailTemplateRevisionAction {
  Create
  Edit
  Status
}
class EmailTemplate {
  +Guid Id
  +string Key
  +string Name
  +string Description
  +EmailTemplateCategory Category
  +EmailTemplateStatus Status
  +string Subject
  +string Preheader
  +string HtmlBody
  +string TextBody
  +string SampleData
  +bool IsSystem
  +int Version
  +DateTimeOffset CreatedAt
  +string CreatedByEmail
  +DateTimeOffset UpdatedAt
  +string UpdatedByEmail
}
class EmailTemplateRevision {
  +Guid Id
  +Guid TemplateId
  +int Version
  +EmailTemplateRevisionAction Action
  +EmailTemplateStatus Status
  +string Name
  +string Subject
  +string Preheader
  +string HtmlBody
  +string TextBody
  +string SampleData
  +DateTimeOffset OccurredAt
  +Guid? AdminUserId
  +string AdminEmail
}
class EmailTemplateCatalog <<static>> {
  +{static} RequiredPlaceholders(key, isSystem, category): IReadOnlyList<string>
  +{static} TryParseCategory(value, out category): bool
  +{static} TryParseStatus(value, out status): bool
}
class EmailTemplateStarters <<static>> {
  +{static} For(category): EmailTemplateContent
}
class EmailTemplateLiquid {
  -FluidParser parser
  +TemplateOptions Options
  +Parse(field, text): IFluidTemplate
  +Analyse(template): LiquidAnalysis
  +Check(field, text, html): LiquidAnalysis
}
class LiquidAnalysis {
  +IReadOnlyList<string> Variables
  +IReadOnlyList<string> Filters
  +bool Includes
}
class EmailTemplateRules <<static>> {
  +{static} CheckHtml(html): void
  +{static} CheckRequired(required, htmlVariables, textVariables): void
}
class EmailTemplateRenderer {
  +BuiltIns(): IReadOnlyDictionary<string, string>
  +Render(subject, preheader, html, text, sampleData): EmailPreviewDto
}
class EmailTemplateRevisionWriter {
  +Write(template, action): void
}
class EmailTemplateDto {
  +Guid id
  +string key
  +string category
  +string status
  +int version
  +string[] requiredPlaceholders
}
class EmailPreviewDto {
  +string subject
  +string preheader
  +string html
  +string text
  +EmailPlaceholderDto[] placeholders
}
EmailTemplate --> EmailTemplateCategory
EmailTemplate --> EmailTemplateStatus
EmailTemplate "1" *-- "many" EmailTemplateRevision : history
EmailTemplateRevision --> EmailTemplateRevisionAction
EmailTemplateRules ..> EmailTemplateCatalog : required placeholders
EmailTemplateLiquid ..> LiquidAnalysis : returns
EmailTemplateRenderer ..> EmailTemplateLiquid : parses and renders (Fluid)
EmailTemplateStarters ..> EmailTemplateCategory : one per
EmailTemplateRevisionWriter ..> EmailTemplateRevision : creates
EmailTemplateDto ..> EmailTemplate : projects
@enduml
