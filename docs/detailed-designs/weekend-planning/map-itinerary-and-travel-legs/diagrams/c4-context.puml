@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context - Map the itinerary and its travel legs

Person(family, "Family member", "Follows the weekend plan")
System(saturdaze, "Saturdaze", "Plans personalized family weekends")
System_Ext(tiles, "Map tile provider", "OpenStreetMap-based tiles")
