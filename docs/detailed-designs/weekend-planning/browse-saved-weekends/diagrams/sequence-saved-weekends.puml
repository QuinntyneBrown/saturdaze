@startuml
title UML sequence behaviour - Browse saved weekends
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "User" as actor
box "Frontend - Saturdaze Angular application" #E0F2FE
 participant "PastPage" as page
 participant "SavedService" as client
end box
box "Backend - Saturdaze API" #D1FADF
 participant "WeekendsController" as controller
end box
box "Backend - Saturdaze Application and Domain" #ECFDF3
 participant "GetWeekendHistoryQueryHandler\ncuration handlers" as handler
end box
box "Backend - Saturdaze Infrastructure" #FFF4E5
 database "AppDbContext\nSQL Server" as db
end box
actor -> page : Open /past
page -> client : load()
client -> controller : GET /api/weekends/history?take=50
controller -> handler : GetWeekendHistoryQuery
handler -> db : Family filter, descending date, Take (L2-025)
db --> handler : Summaries including current/future rows
handler --> controller : Array, possibly empty
controller --> client : 200
client -> client : Local filters and Skipping next time (L2-027)
client --> page : PastView or empty state
actor -> page : Confirm rating/title edit or toggle favourite
page -> client : rate / rename / setFavourite
client -> controller : PUT /api/weekends/{id}/rating, /title or /favourite
controller -> handler : L2-026 family-scoped command
handler -> db : Save target change
db --> handler : Saved
handler --> controller : WeekendDto
controller --> client : 200
client --> page : Patch summary
@enduml
