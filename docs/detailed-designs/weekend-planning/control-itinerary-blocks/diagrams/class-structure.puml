@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Control itinerary blocks

class WeekendPlanService {
  +lockBlock(blockId: string, locked: boolean): Promise<void>
  +swapBlock(blockId: string, rejectedActivityIds?: readonly string[]): Promise<void>
  +lockDay(day: WeekendDay, locked: boolean, id?: string): Promise<void>
  +regenerate(id?: string): Promise<void>
  +regenerateDay(day: WeekendDay, id?: string): Promise<void>
}
class LockBlockCommandHandler {
  +Handle(command: LockBlockCommand): Task<WeekendDto>
}
class SwapBlockCommandHandler {
  +Handle(command: SwapBlockCommand): Task<WeekendDto>
}
class RegenerateWeekendCommandHandler {
  +Handle(command: RegenerateWeekendCommand): Task<WeekendDto>
}
class RegenerateWeekendDayCommandHandler {
  +Handle(command: RegenerateWeekendDayCommand): Task<WeekendDto>
}
class LockWeekendDayCommandHandler {
  +Handle(command: LockWeekendDayCommand): Task<WeekendDto>
}
class Weekend {
  +int RegenerateCount
}
class ItineraryBlock {
  +Guid? RefId
  +bool IsLocked
}
WeekendPlanService ..> LockBlockCommandHandler : invokes through API
LockBlockCommandHandler --> ItineraryBlock : sets lock
SwapBlockCommandHandler --> ItineraryBlock : replaces block and adjacent drives
RegenerateWeekendCommandHandler --> Weekend : increments
RegenerateWeekendDayCommandHandler --> Weekend : increments
LockWeekendDayCommandHandler --> ItineraryBlock : sets day locks
Weekend "1" *-- "*" ItineraryBlock
@enduml
