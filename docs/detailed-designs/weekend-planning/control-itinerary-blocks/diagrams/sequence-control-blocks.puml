@startuml
title UML sequence behaviour — Control itinerary blocks
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "User" as actor
box "Frontend — Saturdaze Angular application" #E0F2FE
 participant "WeekendPage\nBlockDialog" as page
 participant "WeekendPlanService" as client
end box
box "Backend — Saturdaze API" #D1FADF
 participant "BlocksController\nWeekendsController" as controller
end box
box "Backend — Saturdaze Application and Domain" #ECFDF3
 participant "LockBlockCommandHandler\nSwapBlockCommandHandler\nregeneration handlers" as handler
end box
box "Backend — Saturdaze Infrastructure" #FFF4E5
 database "AppDbContext\nSQL Server" as db
end box
actor -> page : Choose block or day operation
page -> client : lockBlock / swapBlock / lockDay / regenerate / regenerateDay
client -> controller : PUT lock endpoint or POST swap/regenerate endpoint
controller -> handler : Authorize and dispatch command
handler -> db : Resolve owned target and blocks
db --> handler : Owned state or absent
alt target absent or another family
handler --> controller : 404
else locked swap or commitment unlock
handler --> controller : 409 block_locked or commitment_locked
else swap has no alternative
handler -> db : Save no-op reason
db --> handler : Saved
handler --> controller : 200 unchanged reference with annotation
else accepted mutation
handler -> handler : L2-014 / L2-015 / L2-016 / L2-085 operation
handler -> db : Save changed state
db --> handler : Saved
handler --> controller : WeekendDto
end
controller --> client : Result
client --> page : Updated itinerary or actionable error
@enduml
