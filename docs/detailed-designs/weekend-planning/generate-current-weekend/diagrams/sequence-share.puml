@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054

title Behaviour - Share and export (L2-086)
actor Owner as owner
actor "Link recipient" as recipient
box "Frontend - Angular application" #E0F2FE
 participant "WeekendPage\nWeekendPlanService" as page
 participant "ShareDialog\nCalendarDialog" as dialog
 participant "SharedWeekendPage\nSharedWeekendService" as sharedPage
end box
box "Backend - API" #D1FADF
 participant WeekendsController as controller
end box
box "Backend - Application" #ECFDF3
 participant "GetWeekendByIdQueryHandler" as owned
 participant "GetSharedWeekendQueryHandler" as shared
end box
box "Backend - Infrastructure" #FFF4E5
 database AppDbContext as db
end box
owner -> page : Share
page -> controller : createShareLink(): POST /api/weekends/{id}/share with bearer
controller -> owned : GetWeekendByIdQuery(id)
owned -> db : Read caller-family weekend
db --> owned : State or absent
alt absent or not owned
 owned --> controller : NotFoundException
 controller --> page : 404
 page --> owner : Error banner
else owned
 owned --> controller : WeekendDto
 controller -> controller : Encode GUID as URL-safe base64
 controller --> page : WeekendShareDto(shareUrl, token)
 page -> dialog : Open ShareDialog with shareUrl
 dialog --> owner : Copy link
 recipient -> sharedPage : /sample-weekend?share=token
 sharedPage -> controller : GET /api/weekends/shared/{token} (anonymous)
 controller -> controller : Decode token; invalid encoding returns 404
 controller -> shared : GetSharedWeekendQuery(id)
 shared -> db : Read weekend with blocks and errands
 db --> shared : Data or 404
 shared --> controller : Full WeekendDto with forecast
 controller --> sharedPage : JSON
 sharedPage --> recipient : Read-only presentation
end
owner -> page : Add to calendar
page -> dialog : Open CalendarDialog with calendarExport()
owner -> controller : GET /api/weekends/{id}/calendar.ics (anonymous)
controller -> shared : GetSharedWeekendQuery(id)
shared --> controller : WeekendDto
controller -> controller : Map blocks to VCALENDAR / VEVENT
controller --> owner : text/calendar
note over controller, shared
Tokens encode IDs; they have no expiry or revocation.
The calendar URL uses the raw weekend ID.
JSON includes Errands, Notes and Weather.
Read-only UI is not a redacted API projection.
end note
@enduml
