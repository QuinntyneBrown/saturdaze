@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054

title Behaviour - Share and export (L2-086)
actor Owner as owner
actor "Link recipient" as recipient
box "Frontend - Angular application" #E0F2FE
 participant "WeekendPage\nWeekendPlanService" as page
 participant "ShareDialog\nCalendarDialog" as dialog
 participant "SharedWeekendPage\nSharedWeekendService" as sharedPage
end box
box "Backend - API" #D1FADF
 participant WeekendsController as controller
end box
box "Backend - Application" #ECFDF3
 participant "ShareWeekendCommandHandler\nStopSharingWeekendCommandHandler" as minting
 participant "GetSharedWeekendQueryHandler" as shared
 participant "GetWeekendByIdQueryHandler" as owned
end box
box "Backend - Infrastructure" #FFF4E5
 database AppDbContext as db
end box
owner -> page : Share
page -> controller : createShareLink(): POST /api/weekends/{id}/share with bearer
controller -> minting : ShareWeekendCommand(id)
minting -> db : Is the weekend the caller family's?
alt absent or not owned
 minting --> controller : NotFoundException
 controller --> page : 404
 page --> owner : Error banner
else owned
 minting -> db : Save WeekendShare(hash of random token, expires in 7 days)
 minting --> controller : Raw token and expiry
 controller --> page : WeekendShareDto(shareUrl, token, expiresAtUtc)
 page -> dialog : Open ShareDialog with shareUrl and stopSharing
 dialog --> owner : Copy link
 recipient -> sharedPage : /sample-weekend?share=token
 sharedPage -> controller : GET /api/weekends/shared/{token} (anonymous)
 controller -> shared : GetSharedWeekendQuery(token)
 shared -> db : Find unrevoked, unexpired share by token hash
 alt unknown, expired or stopped
  shared --> controller : NotFoundException
  controller --> sharedPage : 404
  sharedPage --> recipient : "This link has expired"
 else valid
  shared -> db : Read weekend with blocks
  shared --> controller : WeekendDto with forecast
  controller -> controller : SharedWeekendDto.From: drop notes, errands, home,\nrating, favourite, reasons, errand blocks, directions links
  controller --> sharedPage : JSON
  sharedPage --> recipient : Read-only presentation
 end
end
owner -> dialog : Stop sharing
dialog -> controller : DELETE /api/weekends/{id}/share with bearer
controller -> minting : StopSharingWeekendCommand(id)
minting -> db : Revoke every share of the weekend
controller --> dialog : 204
owner -> page : Add to calendar
page -> dialog : Open CalendarDialog with calendarExport() and calendarFile()
dialog -> controller : GET /api/weekends/{id}/calendar.ics with bearer
controller -> owned : GetWeekendByIdQuery(id), family-scoped
owned --> controller : WeekendDto
controller -> controller : Map blocks to VCALENDAR / VEVENT (titles only)
controller --> dialog : text/calendar blob
dialog --> owner : Saved as the shown .ics file name
recipient -> controller : GET /api/weekends/shared/{token}/calendar.ics (anonymous)
controller -> shared : GetSharedWeekendQuery(token)
controller --> recipient : text/calendar for the shared view
@enduml
