@startuml
title UML sequence behaviour — Generate the current weekend
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Family member" as actor
box "Frontend — Saturdaze web application" #E0F2FE
  participant "HomePage" as page
  participant "WeekendPlanService" as client
end box
box "Backend — Saturdaze API application" #D1FADF
  participant "WeekendsController" as controller
end box
box "Backend — Saturdaze Application and Domain" #ECFDF3
  participant "GetCurrentWeekendQueryHandler and GenerateWeekendCommandHandler" as handler
  participant "Weekend and WeekendPlanner" as entity
end box
box "Backend — Saturdaze Infrastructure" #FFF4E5
  database "Saturdaze database" as db
end box
actor -> page : Open the weekend overview
page -> client : loadCurrent()
client -> controller : GET /api/weekends/current
controller -> controller : Authenticate and validate request
controller -> handler : Send GetCurrentWeekendQuery
handler -> db : Find upcoming weekend and planning inputs
db --> handler : Current state
alt weekend already exists
  handler -> entity : Apply L2-013 existing-plan return
  entity --> handler : Updated state
  handler -> db : Save changes
  db --> handler : Commit result
  handler --> controller : Typed result
  controller --> client : Successful HTTP response
  client --> page : Present feature result
  page --> actor : See the current weekend
else weekend is absent
  handler --> controller : Controlled error
  controller --> client : ProblemDetails response
  client --> page : Present safe error state
  page --> actor : Generate and return L2-012 plan
end
@enduml
