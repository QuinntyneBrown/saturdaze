@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage shopping errands

Container_Boundary(web, "Saturdaze web application") {
  Component(page, "ErrandPage", "Angular component", "Collects shopping task details")
  Component(client, "WeekendPlanService", "Angular service", "Calls the errand endpoint")
}
Container_Boundary(api, "Saturdaze API") {
  Component(controller, "ErrandsController", "ASP.NET Core", "Exposes add and done endpoints")
  Component(handler, "Errand command handlers", "Application handler", "Append or update an errand")
  Component(entity, "Weekend and ShoppingErrand", "Domain state", "Own task and completion state")
  ComponentDb(db, "AppDbContext", "EF Core", "Stores weekends and shopping errands")
}
Rel(page, client, "Calls")
Rel(client, controller, "POST /api/weekends/{id}/errands", "JSON/HTTPS")
Rel(controller, handler, "Dispatches request")
Rel(handler, entity, "Adds or updates")
Rel(handler, db, "Updates errand state", "EF Core")
@enduml
