@startuml
title UML sequence behaviour — Manage shopping errands
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "User" as actor
box "Frontend — Saturdaze Angular application" #E0F2FE
 participant "WeekendPage\nAddErrandDialog\nErrandAddedDialog" as page
 participant "WeekendPlanService" as client
end box
box "Backend — Saturdaze API" #D1FADF
 participant "ErrandsController" as controller
end box
box "Backend — Saturdaze Application and Domain" #ECFDF3
 participant "AddShoppingErrandCommandHandler\nMarkErrandDoneCommandHandler" as handler
end box
box "Backend — Saturdaze Infrastructure" #FFF4E5
 database "AppDbContext\nSQL Server" as db
end box
actor -> page : Submit description, minutes, preferred day
page -> client : addErrand(...)
client -> controller : POST /api/weekends/{id}/errands
controller -> handler : Validated family-scoped command
handler -> db : Load weekend and blocks
db --> handler : Current state
handler -> handler : L2-021 append task; try preferred day then other day
alt slot available
handler -> handler : Reclaim overlapping downtime; insert Errand block
else no slot
handler -> handler : Keep task without a placed block
end
handler -> db : Save task and any block changes
db --> handler : Saved
handler --> controller : WeekendDto
controller --> client : 200
client -> client : Compare before/after to derive placement or null
client --> page : Show acknowledgement and refreshed plan
opt mark errand done
page -> client : setErrandDone(id, done)
client -> controller : PUT /api/errands/{id}/done
controller -> handler : L2-022 done command
handler -> db : Save owned task flag
db --> handler : Saved
handler --> controller : WeekendDto
controller --> client : 200
client --> page : Updated task
end
@enduml
