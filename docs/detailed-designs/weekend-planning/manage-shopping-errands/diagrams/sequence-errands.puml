@startuml
title UML sequence behaviour — Manage shopping errands
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Family member" as actor
box "Frontend — Saturdaze web application" #E0F2FE
  participant "ErrandPage" as page
  participant "WeekendPlanService" as client
end box
box "Backend — Saturdaze API application" #D1FADF
  participant "ErrandsController" as controller
end box
box "Backend — Saturdaze Application and Domain" #ECFDF3
  participant "Errand command handlers" as handler
  participant "Weekend and ShoppingErrand" as entity
end box
box "Backend — Saturdaze Infrastructure" #FFF4E5
  database "Saturdaze database" as db
end box
actor -> page : Submit or complete an errand
page -> client : addErrand() or done request
client -> controller : POST /api/weekends/{id}/errands
controller -> controller : Authenticate and validate request
controller -> handler : Dispatch errand command
handler -> db : Load authorized weekend and errand
db --> handler : Current state
alt input and ownership are valid
  handler -> entity : Apply L2-021 append or L2-022 done flag
  entity --> handler : Updated state
  handler -> db : Save changes
  db --> handler : Commit result
  handler --> controller : Typed result
  controller --> client : Successful HTTP response
  client --> page : Present feature result
  page --> actor : See updated weekend task
else input or target is invalid
  handler --> controller : Controlled error
  controller --> client : ProblemDetails response
  client --> page : Present safe error state
  page --> actor : See validation or not-found error
end
@enduml
