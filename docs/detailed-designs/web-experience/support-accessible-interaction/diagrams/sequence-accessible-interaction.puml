@startuml
title UML sequence behaviour - Support accessible interaction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Keyboard or assistive-technology user" as user
box "Frontend - Saturdaze Angular application" #E0F2FE
  participant "Routed page" as page
  participant "Shared control" as control
  participant "Feature dialog\nCDK" as dialog
end box
box "Frontend - Browser accessibility platform" #D1FADF
  participant "Focus manager" as focus
  participant "Accessibility tree" as tree
end box
box "Frontend - Browser rendering platform" #FFF4E5
  participant "CSS engine" as css
end box
user -> focus : Press Tab
focus -> control : Move focus in DOM order
control -> css : Apply L2-036 visible focus
css --> control : Configured focus style
control -> tree : Expose L2-037 accessible name
tree --> user : Announce control
user -> control : Press Enter or Space
control -> dialog : Open action dialog
dialog -> focus : Trap focus; label container from panel h2
focus --> user : Present operable dialog
dialog -> css : Apply L2-038 color tokens
css --> dialog : Configured color tokens
alt user presses Escape or the labelled close button
  user -> dialog : Dismiss without completing the action
  dialog -> focus : Close CDK dialog and restore focus
  focus --> user : Focus returns to the triggering control
else user activates a dialog action
  user -> dialog : Enter or Space on the action button
  dialog --> page : Close with result
end
@enduml
