@startuml
title Weather endpoint, cache and fallback
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054

box "Frontend — Saturdaze Angular application" #E0F2FE
 participant "ActivityService" as client
end box
box "Backend — Saturdaze API" #D1FADF
 participant "WeatherController" as ctrl
end box
box "Backend — Application" #ECFDF3
 participant "GetWeekendWeatherQueryHandler" as handler
 participant "WeekendForecastService" as forecast
end box
box "Backend — Infrastructure" #FFF4E5
 participant "OpenMeteoWeatherClient" as weather
 database "IMemoryCache" as cache
end box
participant "Open-Meteo" as provider
client -> ctrl : GET /api/weather?weekendOf=... (anonymous)
ctrl -> handler : GetWeekendWeatherQuery
handler -> forecast : GetAsync(date)
forecast -> weather : L2-023 configured coordinates, Saturday-Sunday
weather -> cache : Read coordinate/date key
alt cached
cache --> weather : Forecast
else cache miss
weather -> provider : Forecast HTTP request
alt success
provider --> weather : Weather JSON
weather -> weather : Map WeatherForecast records
weather -> cache : Cache success for 60 minutes
else handled HTTP, JSON or timeout failure
provider --> weather : Failure
weather -> weather : Warn and build L2-040 unavailable entries
end
end
weather --> forecast : Two forecast records
forecast --> handler : Forecast
handler --> ctrl : Forecast
ctrl --> client : 200
note over forecast
WeekendDto-producing handlers use this same service.
Family home text is not geocoded.
end note
@enduml
