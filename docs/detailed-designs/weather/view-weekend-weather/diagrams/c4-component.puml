@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - View weekend weather
Container_Boundary(web, "Saturdaze web application") {
  Component(activities, "ActivityService", "Angular service", "Loads activity weather")
  Component(weekend, "WeekendPlanService", "Angular service", "Maps embedded weekend forecasts")
}
Container_Boundary(api, "Saturdaze API") {
  Component(weather, "WeatherController", "ASP.NET Core", "Anonymous weather endpoint")
  Component(weekends, "WeekendsController", "ASP.NET Core", "Weekend endpoints")
  Component(query, "GetWeekendWeatherQueryHandler", "Application handler", "Requests two weekend days")
  Component(handlers, "Weekend handlers and PlannerInputLoader", "Application services", "Load forecasts for plans")
  Component(forecast, "WeekendForecastService", "Application service", "Uses configured deployment coordinates")
  Component(client, "OpenMeteoWeatherClient", "IWeatherClient and HttpClient", "Maps provider data or unavailable placeholders")
  ComponentDb(cache, "IMemoryCache", "In-process cache", "Caches forecasts for 60 minutes")
}
System_Ext(provider, "Open-Meteo", "External weather provider")
Rel(activities, weather, "GET /api/weather", "JSON/HTTPS")
Rel(weekend, weekends, "Weekend requests", "JSON/HTTPS")
Rel(weather, query, "Dispatches")
Rel(weekends, handlers, "Dispatches")
Rel(query, forecast, "Calls")
Rel(handlers, forecast, "Calls")
Rel(forecast, client, "GetForecastAsync")
Rel(client, cache, "Reads and writes")
Rel(client, provider, "Requests forecasts", "HTTPS")
@enduml
