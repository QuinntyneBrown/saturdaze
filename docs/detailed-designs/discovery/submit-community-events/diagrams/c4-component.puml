@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Submit community events

Container_Boundary(web, "Saturdaze web application") {
  Component(page, "EventsPage, SubmitEventDialog, and EventsSubmitPage", "Angular component", "Collect event input through two entry points")
  Component(client, "EventSubmissionsService", "Angular service", "Submits typed event payloads")
}
Container_Boundary(api, "Saturdaze API") {
  Component(controller, "EventSubmissionsController", "ASP.NET Core", "Exposes authorized submission")
  Component(handler, "SubmitEventCommandHandler", "Application handler", "Validates and stamps ownership")
  Component(entity, "EventSubmission", "Domain state", "Stores pending contributed event data")
  ComponentDb(db, "AppDbContext", "EF Core", "Stores pending event submissions")
}
Rel(page, client, "Calls")
Rel(client, controller, "POST /api/events/submissions", "JSON/HTTPS")
Rel(controller, handler, "Dispatches request")
Rel(handler, entity, "Creates")
Rel(handler, db, "Creates submission state", "EF Core")
@enduml
