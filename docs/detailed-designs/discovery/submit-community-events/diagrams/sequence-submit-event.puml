@startuml
title UML sequence behaviour — Submit community events
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "User" as actor
box "Frontend — Saturdaze Angular application" #E0F2FE
 participant "IdeasPage\nSubmitEventDialog" as page
 participant "EventSubmissionsService" as client
end box
box "Backend — Saturdaze API" #D1FADF
 participant "EventSubmissionsController" as controller
end box
box "Backend — Saturdaze Application and Domain" #ECFDF3
 participant "SubmitEventCommandHandler" as handler
end box
box "Backend — Saturdaze Infrastructure" #FFF4E5
 database "AppDbContext\nSQL Server" as db
end box
actor -> page : Suggest an event (L2-048)
page -> page : Open dialog with nextHourDefault (L2-047)
actor -> page : Submit title and local start
alt browser form invalid
page --> actor : Field errors; no request
else browser form valid
page -> client : submit(payload)
client -> controller : POST /api/events/submissions
controller -> controller : Authorize and validate
controller -> handler : SubmitEventCommand
handler -> db : L2-046 save Pending record with caller and timestamp
db --> handler : Saved
handler --> controller : EventSubmissionDto
controller --> client : 201 Created
client --> page : Submission
page -> page : Open EventSubmittedDialog
page -> client : loadMine()
client --> page : Updated owned submissions
end
@enduml
