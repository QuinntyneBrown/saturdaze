@startuml
title UML sequence behaviour — Submit community events
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Authenticated contributor" as actor
box "Frontend — Saturdaze web application" #E0F2FE
  participant "EventsPage, SubmitEventDialog, and EventsSubmitPage" as page
  participant "EventSubmissionsService" as client
end box
box "Backend — Saturdaze API application" #D1FADF
  participant "EventSubmissionsController" as controller
end box
box "Backend — Saturdaze Application and Domain" #ECFDF3
  participant "SubmitEventCommandHandler" as handler
  participant "EventSubmission" as entity
end box
box "Backend — Saturdaze Infrastructure" #FFF4E5
  database "Saturdaze database" as infra
  end box
actor -> page : Open quick or full submission form
page -> client : submit(SubmitEventRequest)
client -> controller : POST /api/events/submissions
controller -> controller : Authenticate and validate request
controller -> handler : Send SubmitEventCommand
handler -> infra : Validate caller and duplicate boundary
infra --> handler : Current data
alt title and start time are valid
  handler -> entity : Apply L2-046 pending ownership
  entity --> handler : Typed result
  handler --> controller : Typed result
  controller --> client : Successful HTTP response
  client --> page : Present feature result
  page --> actor : See submitted-event confirmation
else input is invalid
  handler --> controller : Controlled alternate result
  controller --> client : Safe HTTP response
  client --> page : Present alternate state
  page --> actor : See field validation error
end
@enduml
