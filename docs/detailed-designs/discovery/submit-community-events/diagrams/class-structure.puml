@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Submit community events

class IdeasPage {
  #suggest(): Promise<void>
}
class SubmitEventDialog {
  #submit(): Promise<void>
}
class EventSubmittedDialog
class EventSubmissionsService {
  +submit(payload: SubmitEventRequest): Promise<EventSubmissionDto>
  +loadMine(): Promise<void>
}
class SubmitEventCommandHandler
class EventSubmission {
  +EventSubmissionStatus Status
  +Guid SubmittedByUserId
  +DateTime StartsAtLocal
}
IdeasPage ..> SubmitEventDialog : opens
IdeasPage ..> EventSubmittedDialog : acknowledges
SubmitEventDialog --> EventSubmissionsService : submits
SubmitEventCommandHandler --> EventSubmission : creates
EventSubmissionsService ..> SubmitEventCommandHandler : through API
@enduml
