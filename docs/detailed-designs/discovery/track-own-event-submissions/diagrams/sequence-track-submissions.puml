@startuml
title UML sequence behaviour — Track own event submissions
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "User" as actor
box "Frontend — Saturdaze Angular application" #E0F2FE
 participant "IdeasEventsPage" as page
 participant "EventsService\nEventSubmissionsService" as client
end box
box "Backend — Saturdaze API" #D1FADF
 participant "EventSubmissionsController" as controller
end box
box "Backend — Saturdaze Application and Domain" #ECFDF3
 participant "ListMySubmissionsQueryHandler" as handler
end box
box "Backend — Saturdaze Infrastructure" #FFF4E5
 database "AppDbContext\nSQL Server" as db
end box
actor -> page : Open events feed
page -> client : load()
client -> controller : GET /api/events/submissions/mine
controller -> handler : ListMySubmissionsQuery after authorization
handler -> db : L2-049 filter SubmittedByUserId by caller
db --> handler : All owned statuses
handler --> controller : EventSubmissionDto array
controller --> client : 200 array, possibly empty
client -> client : Select Pending records; merge with public sections
client --> page : Your suggestion section if nonempty
page --> actor : Owned pending cards
note over client
Reviewed entries remain in mine() API data,
but are absent from the pending feed section.
No rejection notification is sent.
end note
@enduml
