@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Track own event submissions

Container_Boundary(web, "Saturdaze web application") {
  Component(page, "EventsPage", "Angular component", "Merges public and owned pending cards")
  Component(client, "EventSubmissionsService", "Angular service", "Loads caller-owned submissions")
}
Container_Boundary(api, "Saturdaze API") {
  Component(controller, "EventSubmissionsController", "ASP.NET Core", "Exposes the mine endpoint")
  Component(handler, "ListMySubmissionsQueryHandler", "Application handler", "Filters by current user")
  Component(entity, "EventSubmission", "Domain state", "Holds owner and review status")
  ComponentDb(db, "AppDbContext", "EF Core", "Stores submission ownership and status")
}
Rel(page, client, "Calls")
Rel(client, controller, "GET /api/events/submissions/mine", "JSON/HTTPS")
Rel(controller, handler, "Dispatches request")
Rel(handler, entity, "Filters by owner")
Rel(handler, db, "Queries by submitter ID", "EF Core")
@enduml
