@startuml
title UML sequence behaviour - Preview and add an idea
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Family member" as actor
box "Frontend - Saturdaze Angular application" #E0F2FE
 participant "IdeasActivitiesPage\nsd-activity-card" as page
 participant "AddToDayDialog" as dialog
 participant "WeekendPlanService" as client
end box
box "Backend - Saturdaze API" #D1FADF
 participant "WeekendsController" as controller
end box
box "Backend - Saturdaze Application and Domain" #ECFDF3
 participant "Preview / Add handlers" as handler
 participant "IdeaResolver" as resolver
 participant "IdeaPlacementService" as placer
end box
box "Backend - Saturdaze Infrastructure" #FFF4E5
 database "AppDbContext\nSQL Server" as db
end box
actor -> page : Add to day: Royal Botanical Gardens
page -> dialog : Open with ideaKind, ideaId, title
dialog --> actor : "Add Royal Botanical Gardens", Saturday, Best fit (L2-107 AC1)
dialog -> client : previewIdea(request)
client -> controller : POST /api/weekends/{id}/ideas/preview
controller -> handler : PreviewIdeaPlacementQuery
handler -> db : Load caller-family weekend
alt weekend not owned
 handler --> controller : 404
else owned
 handler -> resolver : ResolveAsync(kind, id)
 alt not in a catalog
  resolver --> handler : NotFound (L2-107 AC5)
  handler --> controller : 404
 else resolved
  handler -> placer : Place(day blocks, idea, timing)
  placer -> placer : Locked and commitment blocks fixed (L1-004)
  placer --> handler : 15:00 to 17:00, replaces Quiet time at home
  handler --> controller : IdeaPlacementDto
 end
end
controller --> client : 200 or 404
client --> dialog : IdeaPlacementView
alt Fits = false
 dialog --> actor : No slot message; confirm disabled (L2-107 AC4)
else Fits
 dialog --> actor : "Saturday · 15:00 to 17:00", names replaced block (L2-107 AC2)
 actor -> dialog : Add to Saturday
 dialog -> client : addIdea(request)
 client -> controller : POST /api/weekends/{id}/ideas
 controller -> handler : AddIdeaToWeekendCommand
 handler -> placer : Recompute placement
 alt placement changed since preview
  handler --> controller : 409
  controller --> client : 409
  client --> dialog : Refresh preview
 else unchanged
  handler -> db : Remove replaced, insert Activity block, renumber, save
  db --> handler : Committed
  handler --> controller : WeekendDto
  controller --> client : 200
  client -> client : Replace cached WeekendView (L2-107 AC3)
  client --> dialog : Done
  dialog --> actor : Close dialog
 end
end
@enduml
