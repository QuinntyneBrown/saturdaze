@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Discover local events

Person(actor, "Family member", "Browses community events for a weekend")
System_Boundary(saturdaze, "Saturdaze") {
  Container(web, "Saturdaze web application", "Angular", "Shows grouped public events")
  Container(api, "Saturdaze API", "ASP.NET Core", "Filters the public event catalogue")
  ContainerDb(db, "Saturdaze database", "SQL Server", "Stores approved local events")
}
Rel(actor, web, "Uses", "HTTPS")
Rel(web, api, "Requests weekend events", "JSON/HTTPS")
Rel(api, db, "Queries public events", "EF Core")
@enduml
