@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Discover local events

class IdeasEventsPage {
  #setCategory(chip: FilterChip): void
}
class FilterChip {
  +string Label
  +bool Active
}
class EventsService {
  +load(weekendOfIso: string): Promise<void>
  +list(): Signal<IdeasEventsView>
}
class GetLocalEventsQuery {
  +DateOnly WeekendOf
  +int MaxDriveMinutes
}
class GetLocalEventsQueryHandler {
  +Handle(query: GetLocalEventsQuery): Task<IReadOnlyList<LocalEventDto>>
}
class LocalEvent {
  +DateOnly StartsOn
  +DateOnly EndsOn
  +int DriveMinutes
  +string Category
}
IdeasEventsPage --> EventsService : calls
IdeasEventsPage ..> FilterChip : reads
EventsService ..> GetLocalEventsQuery : maps to
GetLocalEventsQueryHandler --> LocalEvent : filters
@enduml
