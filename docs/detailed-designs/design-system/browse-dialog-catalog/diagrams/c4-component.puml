@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Browse the dialog catalog
Container_Boundary(web, "Documentation SPA") {
  Component(index, "renderDialogsIndex", "Page renderer", "Builds one card per family")
  Component(detail, "renderDialogDetail", "Page renderer", "Renders family tabs")
  Component(examples, "renderDialogExamples", "Scenario renderer", "Builds all inline examples and launch controls")
  Component(fixtures, "dialogMarkup", "Fixture builder", "Composes local sd-dialog markup")
  Component(host, "dialogHost", "DOM host", "Owns one live dialog")
