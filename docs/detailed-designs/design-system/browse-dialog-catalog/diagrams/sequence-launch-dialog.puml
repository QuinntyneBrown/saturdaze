@startuml
title UML sequence behaviour - Launch a live dialog
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Catalog reader" as actor
box "Frontend - Dialog examples page" #E0F2FE
  participant "Launch live button" as launch
  participant "dialogHost" as host
  participant "status region" as status
end box
box "Backend - Catalog interaction layer" #D1FADF
  participant "dialogMarkup" as fixtures
  participant "closeLiveDialog" as close
end box
box "Backend - Native component runtime" #ECFDF3
  participant "SdDialog" as dialog
  participant "sd-button shadow action" as action
end box
box "Backend - Browser platform" #FFF4E5
  participant "Focus and composed event APIs" as browser
end box
actor -> launch : Select Launch live
launch -> fixtures : Build non-static scenario markup
fixtures --> host : Inject live sd-dialog
host -> dialog : Upgrade and open
dialog -> browser : Capture opener and focus first action
browser -> action : Focus inner button on next frame
host -> status : Apply L2-064 announce Dialog opened
alt cancel or confirm button
  actor -> action : Select marked action
  action -> browser : Dispatch composed click
  browser -> close : Match composedPath marker
  close -> host : Clear dialog
  close -> launch : Restore focus
  close -> status : Announce cancellation or confirmation
else Escape, backdrop, or sd-close
  actor -> dialog : Request dismissal
  dialog -> close : Dispatch sd-close
  close -> host : Clear dialog
  close -> launch : Restore focus
  close -> status : Announce Dialog closed
end
@enduml
