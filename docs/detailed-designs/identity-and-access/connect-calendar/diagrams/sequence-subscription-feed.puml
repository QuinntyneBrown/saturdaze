@startuml
title Behaviour - Subscription link (L2-171, L2-172)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Family member" as actor
participant "Calendar application" as calapp
box "Frontend - Saturdaze Angular application" #E0F2FE
 participant "FamilyPage\nCalendarFeedDialog" as page
 participant "CalendarService" as svc
end box
box "Backend - Saturdaze API" #D1FADF
 participant "CalendarController" as controller
end box
box "Backend - Saturdaze Application and Domain" #ECFDF3
 participant "CreateCalendarFeedCommandHandler\nGetCalendarFeedQueryHandler\nStopCalendarFeedCommandHandler" as handler
end box
box "Backend - Saturdaze Infrastructure" #FFF4E5
 database "AppDbContext\nSQL Server" as db
end box
actor -> page : Subscribe from another calendar
page -> svc : createFeed()
svc -> controller : POST /api/calendar/feed
controller -> handler : CreateCalendarFeedCommand
handler -> handler : Raw token; SHA-256 hash (IJwtTokenService)
handler -> db : Replace the family's CalendarFeed (old link stops)
handler --> controller : raw token, once
controller --> page : 201 { url, webcalUrl, createdUtc }
page -> page : D33 with the webcal URL, Copy link, per-app steps
actor -> calapp : Paste the link
calapp -> controller : GET /api/calendar/feed/{token}.ics (anonymous, L2-008)
controller -> handler : GetCalendarFeedQuery(token)
handler -> db : Feed by hash; family's current weekend and blocks
alt unknown or stopped token
handler --> calapp : 404
else valid
handler --> controller : Blocks except drives, downtime and calendar-sourced
controller --> calapp : 200 text/calendar (titles and times, no reasons)
end
actor -> page : Stop, then confirm (D34)
page -> svc : stopFeed()
svc -> controller : DELETE /api/calendar/feed
controller -> handler : StopCalendarFeedCommand
handler -> db : Delete the family's CalendarFeed
handler --> page : 204, not-subscribed state
@enduml
