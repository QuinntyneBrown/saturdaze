@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Connect a calendar

Person(actor, "Family member", "Manages the Calendar section on Family")
System_Boundary(saturdaze, "Saturdaze") {
  Container(web, "Saturdaze web application", "Angular", "Calendar section, dialogs D31 to D34 and the /family/calendar/google return route")
  Container(api, "Saturdaze API", "ASP.NET Core", "Calendar endpoints; exchanges and protects the grant; serves the feed")
  ContainerDb(db, "Saturdaze database", "SQL Server", "Calendar connections and feeds")
  Container(keys, "Data Protection key ring", "Files on /home/data/keys", "Keys that encrypt refresh tokens and sign state")
}
System_Ext(google, "Google OAuth 2.0", "accounts.google.com, oauth2.googleapis.com")
System_Ext(calapp, "Calendar application", "Subscribes to a webcal URL")
Rel(actor, web, "Uses", "HTTPS")
Rel(web, google, "Sends the browser to the consent screen; receives code and state", "HTTPS redirect")
Rel(web, api, "GET /api/calendar, POST authorize|connect|feed, PUT, DELETE", "JSON/HTTPS + bearer")
Rel(api, google, "Token exchange and revocation", "HTTPS")
Rel(api, db, "Reads and writes connections and feeds", "EF Core")
Rel(api, keys, "Protects and unprotects", "ASP.NET Core Data Protection")
Rel(calapp, api, "GET /api/calendar/feed/{token}.ics (anonymous)", "HTTPS")
@enduml
