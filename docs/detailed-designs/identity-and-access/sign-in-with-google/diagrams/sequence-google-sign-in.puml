@startuml
title Behaviour - Sign in with Google (L2-157, L2-158)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Account holder" as actor
participant "Google Identity Services" as google
box "Frontend - Saturdaze Angular application" #E0F2FE
 participant "SignInPage" as page
 participant "GoogleIdentityService" as gsi
 participant "SessionStore\nAuthService" as client
end box
box "Backend - Saturdaze API" #D1FADF
 participant "AuthController" as controller
end box
box "Backend - Saturdaze Application and Domain" #ECFDF3
 participant "SignInWithGoogleCommandHandler\nRefreshTokenIssuer" as handler
end box
box "Backend - Saturdaze Infrastructure" #FFF4E5
 participant "GoogleIdTokenVerifier" as verifier
 database "AppDbContext\nSQL Server" as db
end box
page -> gsi : renderButton(host, onCredential)
gsi -> google : Load gsi/client once; initialize(client id); renderButton
actor -> google : Choose a Google account
google --> page : L2-158 credential (signed ID token)
page -> client : loginWithGoogle(credential, remember)
client -> controller : POST /api/auth/google (anonymous)
controller -> handler : Validate and dispatch SignInWithGoogleCommand
handler -> verifier : VerifyAsync(credential)
verifier -> verifier : Signature, issuer, audience, expiry against cached JWKS
verifier --> handler : GoogleIdentity or null
alt invalid credential or unverified Google email
handler --> controller : 401 google_token_invalid / google_email_unverified
controller --> client : Error
client --> page : Banner "Google sign-in didn't complete"
else verified identity
handler -> db : Find user by GoogleSubject, else by normalized email
db --> handler : User or absent
alt email matches an unverified password account
handler --> controller : 409 email_unverified
controller --> client : Error
client --> page : Banner "Sign in with your password to verify it first"
else linked, verified-email match, or new
handler -> handler : L2-157 link GoogleSubject, or create User + Family (verified, no password)
handler -> handler : Issue access and refresh credentials
handler -> db : Save user, family and RefreshToken
db --> handler : Saved
handler --> controller : AuthSuccessDto
controller --> client : 200
client -> client : L2-007 persist to the selected browser storage tier
client --> page : Authenticated user
page -> page : Navigate to returnUrl or /weekend
end
end
@enduml
