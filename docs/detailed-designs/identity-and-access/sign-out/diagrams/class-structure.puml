@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Sign out

class FamilyPage {
  #signOut(): Promise<boolean>
}
class signOutWith <<function>>
class ConfirmDialog {
  #confirm(): void
  #cancel(): void
}
class SessionStore {
  +logout(): Promise<void>
}
class RevokeRefreshTokenCommandHandler {
  +Handle(request: RevokeRefreshTokenCommand, ct: CancellationToken): Task
}
class RefreshToken {
  +Guid UserId
  +DateTimeOffset? RevokedAtUtc
}
FamilyPage ..> signOutWith
signOutWith ..> ConfirmDialog : via confirmWith
signOutWith --> SessionStore : after confirmation
SessionStore ..> RevokeRefreshTokenCommandHandler : through AuthService / API
RevokeRefreshTokenCommandHandler --> RefreshToken : revokes
@enduml
