@startuml
title UML sequence behaviour — Sign out
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "User" as actor
box "Frontend — Saturdaze Angular application" #E0F2FE
 participant "FamilyPage\naccount menu\nsignOutWith" as page
 participant "SessionStore\nAuthService" as client
end box
box "Backend — Saturdaze API" #D1FADF
 participant "AuthController" as controller
end box
box "Backend — Saturdaze Application and Domain" #ECFDF3
 participant "RevokeRefreshTokenCommandHandler" as handler
end box
box "Backend — Saturdaze Infrastructure" #FFF4E5
 database "AppDbContext\nSQL Server" as db
end box
actor -> page : Choose Sign out
page -> page : Open ConfirmDialog
alt cancelled or dismissed
page --> actor : Session retained; no logout call
else confirmed
page -> client : logout()
opt refresh token exists
client -> controller : POST /api/auth/logout {refreshToken}
controller -> handler : Validate and dispatch anonymous revocation
handler -> db : Find token hash
db --> handler : Token or absent
opt active and permitted by optional bearer owner
handler -> db : L2-003 set RevokedAtUtc; save
db --> handler : Saved
end
handler --> controller : Completed
controller --> client : 204
end
client -> client : Clear both credential stores even after network failure
client --> page : Completed
page --> actor : Navigate /sign-in
end
@enduml
