@startuml
title UML sequence behaviour — Verify an email address
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "User" as actor
box "Frontend — Saturdaze Angular application" #E0F2FE
 participant "VerifyEmailPage" as page
 participant "SessionStore\nAuthService" as client
end box
box "Backend — Saturdaze API" #D1FADF
 participant "AuthController" as controller
end box
box "Backend — Saturdaze Application and Domain" #ECFDF3
 participant "VerifyEmailCommandHandler" as handler
end box
box "Backend — Saturdaze Infrastructure" #FFF4E5
 database "AppDbContext\nSQL Server" as db
end box
actor -> page : Open /verify-email
alt no query token
page --> actor : Sent state with resend action
else token supplied
page -> client : verifyEmail({token})
client -> controller : POST /api/auth/verify-email (anonymous)
controller -> handler : VerifyEmailCommand
handler -> db : Load hashed token and user
db --> handler : State
alt token valid
handler -> db : L2-006 consume token and stamp EmailVerifiedUtc
db --> handler : Saved
handler --> controller : UserDto
controller --> client : 200
client --> page : Verified state
else invalid or expired
handler --> controller : Token error
controller --> client : Error
client --> page : Expired state; resend or sign-in action
end
end
@enduml
