@startuml
title UML sequence behaviour — Verify an email address
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Account holder" as actor
box "Frontend — Saturdaze web application" #E0F2FE
  participant "VerifyEmailPage" as page
  participant "SessionStore and AuthService" as client
end box
box "Backend — Saturdaze API application" #D1FADF
  participant "AuthController" as controller
end box
box "Backend — Saturdaze Application and Domain" #ECFDF3
  participant "VerifyEmailCommandHandler" as handler
  participant "EmailVerificationToken and User" as entity
end box
box "Backend — Saturdaze Infrastructure" #FFF4E5
  database "Saturdaze database" as db
end box
actor -> page : Open verification link
page -> client : verifyEmail(VerifyEmailRequest)
client -> controller : POST /api/auth/verify-email
controller -> controller : Authenticate and validate request
controller -> handler : Send VerifyEmailCommand
handler -> db : Load verification token and user
db --> handler : Current state
alt token is valid and unexpired
  handler -> entity : Apply L2-006 verification
  entity --> handler : Updated state
  handler -> db : Save changes
  db --> handler : Commit result
  handler --> controller : Typed result
  controller --> client : Successful HTTP response
  client --> page : Present feature result
  page --> actor : See verified-account actions
else token is invalid or expired
  handler --> controller : Controlled error
  controller --> client : ProblemDetails response
  client --> page : Present safe error state
  page --> actor : See verification error and recovery link
end
@enduml
