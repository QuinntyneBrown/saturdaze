@startuml
title UML sequence behaviour - Recover a password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "User" as actor
box "Frontend - Saturdaze Angular application" #E0F2FE
 participant "ResetPasswordPage" as page
 participant "SessionStore\nAuthService" as client
end box
box "Backend - Saturdaze API" #D1FADF
 participant "AuthController" as controller
end box
box "Backend - Saturdaze Application and Domain" #ECFDF3
 participant "ForgotPasswordCommandHandler\nResetPasswordCommandHandler" as handler
end box
box "Backend - Saturdaze Infrastructure" #FFF4E5
 database "AppDbContext\nSQL Server" as db
end box
actor -> page : Request reset link
page -> client : forgotPassword({email})
client -> controller : POST /api/auth/forgot-password
controller -> handler : Validate anonymous request
handler -> db : Find user; save reset token only when account exists
db --> handler : Result
handler --> controller : Delivery metadata or empty result
controller --> client : 202; metadata only in Development / Testing
client --> page : Sent state (L2-004)
note over handler
No email provider dispatch exists.
end note
actor -> page : Open token link and submit matching passwords
page -> client : resetPassword({token, password})
client -> controller : POST /api/auth/reset-password
controller -> handler : ResetPasswordCommand
handler -> db : Load token and user
db --> handler : State
alt invalid, consumed, or expired token
handler --> controller : 400 token_invalid or token_expired
controller --> client : Error
client --> page : Expired / error state
else accepted token and length
handler -> db : L2-005 consume token, update hash, revoke sessions, issue pair
db --> handler : Saved
handler --> controller : AuthSuccessDto
controller --> client : 200
client --> page : Done state; returned pair is not persisted
end
@enduml
