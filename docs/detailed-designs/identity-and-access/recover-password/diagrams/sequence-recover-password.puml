@startuml
title UML sequence behaviour — Recover a password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Signed-out account holder" as actor
box "Frontend — Saturdaze web application" #E0F2FE
  participant "ForgotPasswordPage and ResetPasswordPage" as page
  participant "SessionStore and AuthService" as client
end box
box "Backend — Saturdaze API application" #D1FADF
  participant "AuthController" as controller
end box
box "Backend — Saturdaze Application and Domain" #ECFDF3
  participant "ForgotPasswordCommandHandler and ResetPasswordCommandHandler" as handler
  participant "PasswordResetToken and User" as entity
end box
box "Backend — Saturdaze Infrastructure" #FFF4E5
  database "Saturdaze database" as db
end box
actor -> page : Start password recovery
page -> client : Submit email or token and password
client -> controller : POST /api/auth/forgot-password or reset-password
controller -> controller : Authenticate and validate request
controller -> handler : Dispatch recovery command
handler -> db : Load account or reset-token state
db --> handler : Current state
alt request is safe or token is valid
  handler -> entity : Apply L2-004 disclosure control and L2-005 reset
  entity --> handler : Updated state
  handler -> db : Save changes
  db --> handler : Commit result
  handler --> controller : Typed result
  controller --> client : Successful HTTP response
  client --> page : Present feature result
  page --> actor : See check-email or reset success state
else input or token is invalid
  handler --> controller : Controlled error
  controller --> client : ProblemDetails response
  client --> page : Present safe error state
  page --> actor : See non-leaky recovery error
end
@enduml
