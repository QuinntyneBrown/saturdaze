@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Recover a password

class ResetPasswordPage {
  #sendLink(): Promise<void>
  #savePassword(): Promise<void>
  #startOver(): void
}
class SessionStore {
  +forgotPassword(req: ForgotPasswordRequest): Promise<void>
  +resetPassword(req: ResetPasswordRequest): Promise<void>
}
class ForgotPasswordCommandHandler
class ResetPasswordCommandHandler
class RefreshTokenIssuer
class PasswordResetToken {
  +Guid UserId
  +DateTimeOffset ExpiresAtUtc
  +DateTimeOffset? ConsumedAtUtc
}
class User {
  +string PasswordHash
}
ResetPasswordPage --> SessionStore
SessionStore ..> ForgotPasswordCommandHandler : through AuthService / API
SessionStore ..> ResetPasswordCommandHandler : through AuthService / API
ForgotPasswordCommandHandler --> PasswordResetToken : creates
ResetPasswordCommandHandler --> PasswordResetToken : consumes
ResetPasswordCommandHandler --> User : updates
ResetPasswordCommandHandler --> RefreshTokenIssuer : revokes and issues
@enduml
