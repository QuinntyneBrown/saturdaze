@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Secure authenticated requests

class authInterceptor <<HttpInterceptorFn>>
class SessionStore {
  +refreshSession(): Promise<boolean>
}
class CurrentUserFamilyAccessor {
  +GetCurrentFamilyIdAsync(ct: CancellationToken): Task<Guid>
}
class JwtBearerPostConfigure
class Pbkdf2PasswordHasher {
  +Hash(password: string): string
  +Verify(hash: string, password: string): bool
}
class JwtTokenService {
  +CreateAccessToken(user: User): string
  +CreateRawRefreshToken(): string
  +HashRefreshToken(raw: string): string
}
class RefreshTokenIssuer
class RefreshToken {
  +DateTimeOffset CreatedAtUtc
  +DateTimeOffset ExpiresAtUtc
  +string? CreatedByIp
  +Guid? ReplacedByTokenId
}
authInterceptor --> SessionStore : credentials and refresh
authInterceptor ..> JwtBearerPostConfigure : bearer over HTTP
RefreshTokenIssuer --> JwtTokenService : creates token material
RefreshTokenIssuer --> RefreshToken : creates audit state
note bottom of Pbkdf2PasswordHasher
Called by account handlers;
independent of JWT signing.
end note
@enduml
