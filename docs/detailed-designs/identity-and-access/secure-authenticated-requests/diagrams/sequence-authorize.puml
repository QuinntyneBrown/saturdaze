@startuml
title UML sequence behaviour — Secure authenticated requests
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "User" as actor
box "Frontend — Saturdaze Angular application" #E0F2FE
 participant "Protected route" as page
 participant "authInterceptor\nSessionStore" as client
end box
box "Backend — Saturdaze API" #D1FADF
 participant "JWT middleware\ncontroller policy" as controller
end box
box "Backend — Saturdaze Application and Domain" #ECFDF3
 participant "CurrentUserFamilyAccessor\napplication handler" as handler
end box
box "Backend — Saturdaze Infrastructure" #FFF4E5
 database "AppDbContext\nSQL Server" as db
end box
actor -> page : Open protected route
page -> client : Await rehydrate and requireAuth
opt token within 60 s of expiry
client -> client : Shared refreshSession exchange (L2-033)
end
client -> controller : Request with bearer
alt invalid or absent bearer
controller --> client : 401 before handler
client -> client : Refresh once and retry eligible request
else authenticated
controller -> controller : Enforce endpoint role policy (L2-008)
controller -> handler : Authorized request
handler -> db : Resolve caller family; parameterized scoped query
db --> handler : Owned data or absent
alt another family's ID or absent row
handler --> controller : 404
else found
handler --> controller : Feature result
end
controller --> client : Response
end
client --> page : Result or /sign-in redirect after failed recovery
note over client
Auth exchange and logout never enter retry loops.
end note
@enduml
