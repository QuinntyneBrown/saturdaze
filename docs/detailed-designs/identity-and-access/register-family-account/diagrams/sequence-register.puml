@startuml
title UML sequence behaviour — Register a family account
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "User" as actor
box "Frontend — Saturdaze Angular application" #E0F2FE
 participant "CreateAccountPage" as page
 participant "SessionStore\nAuthService" as client
end box
box "Backend — Saturdaze API" #D1FADF
 participant "AuthController" as controller
end box
box "Backend — Saturdaze Application and Domain" #ECFDF3
 participant "RegisterUserCommandHandler\nRefreshTokenIssuer" as handler
end box
box "Backend — Saturdaze Infrastructure" #FFF4E5
 database "AppDbContext\nSQL Server" as db
end box
actor -> page : Submit accepted terms and credentials
page -> client : signUp(SignupRequest)
client -> controller : POST /api/auth/register (anonymous)
controller -> handler : Validate and dispatch RegisterUserCommand
handler -> db : Check normalized email
db --> handler : Existing or absent account
alt duplicate email
handler --> controller : 409 email_in_use
controller --> client : Conflict
client --> page : Field error
else valid new account
handler -> handler : L2-001 hash password; create User, Family and refresh state
handler -> db : Save account records
db --> handler : Saved
handler --> controller : AuthSuccessDto
controller --> client : 201 Created
client -> client : Persist pair in localStorage
client --> page : Current user
page --> actor : /verify-email
end
@enduml
