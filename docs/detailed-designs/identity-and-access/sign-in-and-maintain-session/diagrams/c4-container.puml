@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Sign in and maintain a session

Person(actor, "Account holder", "Authenticates to use family features")
System_Boundary(saturdaze, "Saturdaze") {
  Container(web, "Saturdaze web application", "Angular", "Hosts login and session state")
  Container(api, "Saturdaze API", "ASP.NET Core", "Authenticates credentials")
  ContainerDb(db, "Saturdaze database", "SQL Server", "Stores users and refresh tokens")
}
Rel(actor, web, "Uses", "HTTPS")
Rel(web, api, "Submits credentials", "JSON/HTTPS")
Rel(api, db, "Reads users and writes refresh tokens", "EF Core")
@enduml
