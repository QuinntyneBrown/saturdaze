@startuml
title UML sequence behaviour - Sign in and maintain a session
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "User" as actor
box "Frontend - Saturdaze Angular application" #E0F2FE
 participant "SignInPage" as page
 participant "SessionStore\nAuthService" as client
end box
box "Backend - Saturdaze API" #D1FADF
 participant "AuthController" as controller
end box
box "Backend - Saturdaze Application and Domain" #ECFDF3
 participant "LoginCommandHandler\nRefreshTokenIssuer" as handler
end box
box "Backend - Saturdaze Infrastructure" #FFF4E5
 database "AppDbContext\nSQL Server" as db
end box
actor -> page : Submit email, password, remember choice
page -> client : login(request, remember)
client -> controller : POST /api/auth/login (anonymous)
controller -> handler : Validate and dispatch LoginCommand
handler -> db : Load normalized email
db --> handler : User or absent
alt valid password
handler -> handler : L2-002 issue access and refresh credentials
handler -> db : Save RefreshToken
db --> handler : Saved
handler --> controller : AuthSuccessDto
controller --> client : 200
client -> client : L2-007 persist to selected browser storage tier
client --> page : Authenticated user
else invalid credentials
handler --> controller : 401 invalid_credentials
controller --> client : Generic credential error
client --> page : Error state
end
@enduml
