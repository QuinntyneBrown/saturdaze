@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Schedule ingestion
Person(operator, "Operator")
System_Boundary(system, "Saturdaze") {
 Container(worker, "Saturdaze Worker", ".NET Generic Host", "Cron loop or run-once mode")
 Container(cli, "Saturdaze CLI with WebJob wrapper", ".NET console and shell", "Alternative externally scheduled entry")
 ContainerDb(db, "Catalog and audit database", "SQL Server", "Stores catalog records and ingestion runs")
}
System_Ext(provider, "Anthropic web search", "External provider")
System_Ext(scheduler, "External scheduler", "Optional trigger; deployment not included")
Rel(operator, worker, "Configures schedule options")
Rel(scheduler, worker, "Starts run-once host")
Rel(scheduler, cli, "Invokes packaged wrapper")
Rel(worker, db, "Uses scoped IngestionRunner", "EF Core")
Rel(cli, db, "Uses scoped IngestionRunner", "EF Core")
Rel(worker, provider, "Researches", "HTTPS")
Rel(cli, provider, "Researches", "HTTPS")
@enduml

