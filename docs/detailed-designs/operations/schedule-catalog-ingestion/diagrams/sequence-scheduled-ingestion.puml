@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054

title Behaviour - Scheduled ingestion (L2-082)
box "Backend - Worker host" #D1FADF
 participant "Generic Host" as host
 participant IngestionWorker as worker
end box
box "Backend - Application" #ECFDF3
 participant CronSchedule as cron
 participant IngestionRunner as runner
end box
box "Backend - Infrastructure" #FFF4E5
 participant "DI scope factory" as scopes
 database "Catalogs and audit" as db
end box
host -> worker : ExecuteAsync(stoppingToken)
alt Enabled = false
 worker --> host : Return; host remains idle
else enabled and recurring mode
 opt RunOnStartup
 worker -> scopes : Create scope; resolve runner
 worker -> runner : RunAsync(types, false, ct)
 runner -> db : Research pipeline and audit writes
 runner --> worker : Results or caught pass failure
 worker -> scopes : Dispose scope
 end
 worker -> cron : TryParse(Cron)
 cron --> worker : Schedule or invalid
 alt invalid schedule
 worker -> host : StopApplication()
 else valid schedule
 loop until shutdown
 worker -> cron : GetNextOccurrence(UtcNow)
 cron --> worker : Next UTC instant
 worker -> worker : Wait in chunks <= 1 hour; cancellation ends loop
 worker -> scopes : Create scope; resolve runner
 worker -> runner : RunAsync(types, false, ct)
 runner -> db : Research pipeline and audit writes
 runner --> worker : Per-type results or exception
 worker -> worker : Log status; catch pass error; retain recurring loop
 worker -> scopes : Dispose scope
 end
 end
end
note over worker
Next occurrence is calculated after each pass.
No catch-up queue or distributed replica lease exists.
An unresolvable next occurrence stops the host.
end note
@enduml

