# Copy to evals/assert/.env (git-ignored) or export in the shell. Never commit keys.

# The Foundry account the Claude deployment lives in (e.g. sd-ai-uofnt2) and its key.
# Without ANTHROPIC_FOUNDRY_API_KEY every behaviour is skipped (L2-212).
FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=

# ASSERT's tester and judge reach the same deployment through LiteLLM (azure_ai/claude-sonnet-5).
AZURE_AI_API_KEY=
AZURE_AI_API_BASE=https://<resource>.services.ai.azure.com/anthropic

# The e2e API the target drives (eng/Start-E2eApi.ps1) and its seeded administrator.
SATURDAZE_API_URL=http://localhost:5100
SATURDAZE_ADMIN_EMAIL=admin@saturdaze.ca
SATURDAZE_ADMIN_PASSWORD=password123
